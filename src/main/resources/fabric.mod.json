{
	"schemaVersion": 1,
	"id": "onedot",
	"version": "${version}",
	"name": "OneDot",
	"description": "Restores the \"1.\" to the start of the Minecraft Client version number",
	"authors": [
		"Joshua Peisach (JPeisach / ItzSwirlz)"
	],
	"contact": {
		"homepage": "https://github.com/JPeisach/OneDot",
		"sources": "https://github.com/JPeisach/OneDot"
	},
	"license": "GNU General Public License v3.0",
	"icon": "assets/onedot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.jpeisach.onedot.OneDot"
		],
		"client": [
			"com.github.jpeisach.onedot.OneDotClient"
		]
	},
	"mixins": [
		"onedot.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "26.1-alpha.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}
